{
  "name": "writing-coach",
  "version": "0.1.0",
  "description": "An AI writing coach that restructures your ideas into LinkedIn posts and blog articles. It changes the structure, never your words. Includes a voice-dictated journal it mines critically for post ideas.",
  "license": "MIT",
  "author": "Francisco José Delicado González",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franndeli/writing-coach.git"
  },
  "keywords": [
    "pi-package",
    "agent-skills",
    "writing",
    "linkedin",
    "blogging",
    "journal",
    "claude-code",
    "codex"
  ],
  "files": [
    "skills/",
    "prompts/",
    "commands/",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests",
    "prepublishOnly": "python3 -m unittest discover -s tests"
  },
  "homepage": "https://github.com/franndeli/writing-coach#readme",
  "bugs": {
    "url": "https://github.com/franndeli/writing-coach/issues"
  }
}
